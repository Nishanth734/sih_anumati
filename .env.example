# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/anumati

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Environment
NODE_ENV=development

# Groq API Key (Get key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Pinecone Vector Search (Get key from https://app.pinecone.io)
# Create index named "anumati-statutory-rag" with Dimension: 384, Metric: cosine
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=anumati-statutory-rag

# Optional Redis / Caching
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
